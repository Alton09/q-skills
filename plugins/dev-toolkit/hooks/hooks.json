{
  "description": "dev-toolkit SessionStart hook: nudges when merged PRs await a retro",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pr-retro-nudge.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
