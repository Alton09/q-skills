{
  "name": "notify-me",
  "version": "1.0.0",
  "description": "Send macOS and Linux system notifications from Claude Code",
  "triggers": ["notify-me", "notify", "send notification"],
  "executable": "notify-me.sh",
  "args": [
    {
      "name": "message",
      "type": "string",
      "required": true,
      "description": "Notification body text"
    },
    {
      "name": "title",
      "type": "string",
      "required": false,
      "default": "Claude Code",
      "description": "Notification title"
    },
    {
      "name": "subtitle",
      "type": "string",
      "required": false,
      "description": "Optional subtitle line"
    }
  ],
  "platform": ["darwin", "linux"],
  "dependencies": ["terminal-notifier (macOS)", "notify-send (Linux, libnotify)"]
}
